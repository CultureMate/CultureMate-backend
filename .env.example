# 복사해서 .env 로 저장하세요. Git에 .env 를 올리지 마세요.
# Windows: copy .env.example .env
# macOS/Linux: cp .env.example .env

# 서울 열린데이터광장 일반 인증키 (culturalEventInfo). 없으면 목록이 502
SEOUL_API_KEY=

# OpenAI API 키. 없으면 AI 소개문만 503(AI_UNAVAILABLE), 나머지는 정상 동작
OPENAI_API_KEY=
# 비워 두면 yml 기본값이 적용되지 않아 AI 소개문이 503이 됩니다
OPENAI_MODEL=gpt-4o-mini

SERVER_PORT=8080

FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
FRONTEND_URL=http://localhost:3000

H2_DB_PATH=./data/cultureevents

# Docker MariaDB (compose.yaml, docker 프로필). 기본 실행은 H2라 없어도 됩니다
DB_NAME=culturemate
DB_USERNAME=culturemate
DB_PASSWORD=
# PC에 설치된 MariaDB/MySQL이 3306을 쓰는 경우가 많아 3308로 연다
DB_PORT=3308

# --- 전체 Docker 실행(docker compose up --build)에서만 쓰는 값 ---
# 프론트 저장소 위치(compose.yaml 기준). 두 저장소를 같은 폴더에 받았다면 그대로 둡니다
# FRONTEND_DIR=../CultureMate-frontend
# 카카오맵 JavaScript 키. 프론트 이미지를 빌드할 때 들어갑니다. 콘솔 Web 도메인에 http://localhost 등록
KAKAO_MAP_KEY=
# Docker에서는 화면과 API가 모두 http://localhost 이므로 아래 기본값을 씁니다(위 FRONTEND_*, KAKAO_REDIRECT_URI는 로컬 개발용)
# 카카오 콘솔 Redirect URI에 http://localhost/api/auth/kakao/callback 도 등록하세요
# DOCKER_FRONTEND_URL=http://localhost
# DOCKER_KAKAO_REDIRECT_URI=http://localhost/api/auth/kakao/callback
# 80·8080 포트가 이미 쓰이고 있을 때만 바꿉니다
# FRONTEND_PORT=80
# BACKEND_PORT=8080

# 카카오 디벨로퍼스 REST API 키. 없으면 로그인만 503, 둘러보기·찜은 됨
# Redirect URI 를 콘솔에 그대로 등록: http://localhost:8080/api/auth/kakao/callback
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback
# 카카오 디벨로퍼스 > 앱 키 > 어드민 키. 회원 탈퇴 시 카카오 연결 끊기에 사용
# 없으면 연결 끊기만 건너뛰고 탈퇴는 됨(다시 로그인할 때 동의 화면 없이 바로 가입됨)
# 모든 API 권한이 있는 키라서 서버 .env 에만 두고 프론트·코드·로그에 넣지 마세요
KAKAO_ADMIN_KEY=

# Google Places API 키. 없으면 장소 검색·상세·사진 API가 503(PLACES_UNAVAILABLE)을 반환
GOOGLE_PLACES_API_KEY=

# --- Places 호출 제한 (선택) ---
# 기본값을 바꿀 때만 아래 줄 맨 앞의 # 을 지우고 숫자를 넣으세요.
# 주의: 값을 비운 채(PLACES_...=)로 두면 빈 문자열로 읽혀 서버가 시작되지 않습니다. 안 쓸 거면 # 로 주석 처리해 두세요.
# 주의: .env는 한 줄 뒤에 주석을 붙일 수 없습니다(값에 주석까지 포함됨). 설명은 항상 윗줄에 적으세요.
# 같은 회원의 1분당 검색 호출 수(nearby + between 합산). 기본 20
# PLACES_SEARCH_PER_MINUTE=20
# 같은 회원의 1분당 사진 호출 수. 기본 40
# PLACES_PHOTO_PER_MINUTE=40
# 같은 회원의 하루 검색 호출 수. 기본 20
# PLACES_SEARCH_PER_MEMBER_DAILY=20
# 같은 회원의 하루 사진 호출 수. 기본 20
# PLACES_PHOTO_PER_MEMBER_DAILY=20
# 서버 전체 월간 검색 호출 수(구글 무료 1,000건 기준으로 여유 100건). 기본 900
# PLACES_SEARCH_MONTHLY_LIMIT=900
# 서버 전체 월간 사진 호출 수. 기본 900
# PLACES_PHOTO_MONTHLY_LIMIT=900
# 같은 회원의 1분당 Place Details 호출 수. 기본 20
# PLACES_DETAIL_PER_MINUTE=20
# 같은 회원의 하루 Place Details 호출 수. 기본 20
# PLACES_DETAIL_PER_MEMBER_DAILY=20
# 서버 전체 월간 Place Details 호출 수. 기본 900
# PLACES_DETAIL_MONTHLY_LIMIT=900
